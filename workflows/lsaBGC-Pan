		sys.stderr.write(msg + '\n')
		logObject.warning(msg)
		logObject.warning(traceback.format_exc())

	# Step 6: Taking a break for user examination of clustering and population delineation
	msg = '--------------------\nStep 6: Taking a break for user examination of GCF clustering and population delineations\n--------------------'
	sys.stderr.write(msg + '\n')
	logObject.info(msg)

	step_6_checkpoint_file = check_dir + 'Step_6.txt'
	if not os.path.isfile(step_6_checkpoint_file) and not no_break_flag:

		msg_about_manual_param_selection = """
Breaking workflow! 
------------------
This is to give you an opportunity to adjust parameters for GCF
clustering and population stratification based on manual assessment
of the PDF report showing the impact of parameters on clustering
found at: %s 
and PDF graphics of the species phylogeny with 
different population divisions marked which can be found in the 
directory %s. 
An interactive HTML view of the species phylogeny alongside population
designations at each cutoff and GCF presence/absence is available at: 
%s
For more insight into how to select appropriate 
parameters, check out: 
https://github.com/Kalan-Lab/lsaBGC-Pan/wiki/7.-guide-to-parameter-selections-during-midway-break

To resume the workflow afterwards, re-run the same command (with any adjusted
parameters) using the same output directory. Add -y/--resume to skip the
confirmation prompt (required when running via Docker or as a batch job).
		""" % (cluster_results_dir + '', popstrat_results_dir + '', interactive_phylogeny_html)
	
		logObject.info(msg_about_manual_param_selection)
		sys.stdout.write(msg_about_manual_param_selection + '\n')
		pathlib.Path(step_6_checkpoint_file).touch()
		sys.exit(0)

	bgc_to_gcf = {}
	for f in os.listdir(gcf_listing_dir):
		gcf_file = gcf_listing_dir + f
		gcf_id = f.split('.txt')[0]
		with open(gcf_file) as ogf:
			for line in ogf:
				bgc_path = line.strip()
				bgc_to_gcf[bgc_path] = gcf_id
	
	sample_to_pop = {}
	if manual_populations_file == None:
		with open(popstrat_file) as opf:
			for i, line in enumerate(opf):
				if i == 0: continue
				line = line.strip()
				ls = line.split('\t')
				sample_to_pop[ls[0]] = ls[1]
	else:
		sample_to_pop = defaultdict(lambda: 'Clade_Not_Provided')
		try:
			with open(manual_populations_file) as ompf:
				for line in ompf:
					line = line.strip()
					ls = line.split('\t')
					sample_to_pop[ls[0]] = ls[1]
		except Exception as e:
			msg = 'Difficulties processing manual population specifications file.'
			sys.stderr.write(msg + '\n')
			sys.stderr.write(traceback.format_exc())
			logObject.error(msg)
			logObject.error(traceback.format_exc())
			sys.exit(1)

	detailed_BGC_listing_with_Pop_and_GCF_map_file = outdir + 'Detailed_BGC_Listing.with_Population_and_GCF_Labels.txt'
	with open(detailed_BGC_listing_with_Pop_and_GCF_map_file, 'w') as dblf_handle:
		dblf_handle.write('\t'.join(['sample', 'population', 'method', 'genome_path', 'bgc_id', 'bgc_path', 'bgc_type', 'gcf_id', 'scaffold', 'start', 'end', 'bgc_length', 'dist_to_edge']) + '\n')
		with open(detailed_BGC_listing_file) as odblf:
			for i, line in enumerate(odblf):
				if i == 0: continue
				line = line.strip()
				ls = line.split('\t')
				pop = sample_to_pop[ls[0]]
				gcf = bgc_to_gcf[ls[4]]
				updated_ls = [ls[0], pop] + ls[1:6] + [gcf] + ls[6:] 
				dblf_handle.write('\t'.join(updated_ls) + '\n')

	# Invalidate checkpoints of downstream steps (7-11) if GCF or population designations changed since they were run 
	# (e.g. because the workflow was resumed with different clustering or population stratification parameters), 
	# otherwise their results would refer to outdated GCF/population labels.
	labels_signature_file = check_dir + 'GCF_and_Population_Labels.md5'
	with open(detailed_BGC_listing_with_Pop_and_GCF_map_file, 'rb') as odlf:
		current_labels_signature = hashlib.md5(odlf.read()).hexdigest()
	previous_labels_signature = None
	if os.path.isfile(labels_signature_file):
		with open(labels_signature_file) as olsf:
			previous_labels_signature = olsf.read().strip()
	if current_labels_signature != previous_labels_signature:
		downstream_checkpoints = [check_dir + 'Step_%d.txt' % i for i in range(7, 12)]
		existing_downstream_checkpoints = [x for x in downstream_checkpoints if os.path.isfile(x)]
		if len(existing_downstream_checkpoints) > 0:
			if previous_labels_signature == None:
				msg = 'Unable to verify that GCF/population designations are the same as when steps 7-11 were previously run, so these steps will be rerun to make sure results are consistent.'
			else:
				msg = 'GCF and/or population designations changed since steps 7-11 were previously run (e.g. due to different clustering or population parameters), so these steps will be rerun.'
			sys.stderr.write(msg + '\n')
			logObject.warning(msg)
			for cf in existing_downstream_checkpoints:
				os.remove(cf)
		with open(labels_signature_file, 'w') as olsf:
			olsf.write(current_labels_signature + '\n')
	
	# Step 7: Running zol and cgc
	msg = '--------------------\nStep 7: Running zol analyses\n--------------------'
	sys.stderr.write(msg + '\n')
	logObject.info(msg)
	step_7_checkpoint_file = check_dir + 'Step_7.txt'
	zol_results_dir = outdir + 'zol_Results/'
	cgc_results_dir = visual_results_dir + 'cgc_Results/'
	zol_comp_results_dir = zol_results_dir + 'Comprehensive/'
	zol_full_results_dir = zol_results_dir + 'Complete_Instances/'
	if not os.path.isfile(step_7_checkpoint_file):
		util.setupReadyDirectory([zol_results_dir, zol_comp_results_dir, zol_full_results_dir, cgc_results_dir])
		ortholog_listing_file = util.reformatOrthologInfo(ortholog_matrix_file, zol_results_dir, logObject)
		util.runZol(detailed_BGC_listing_with_Pop_and_GCF_map_file, ortholog_listing_file, pairwise_relations, zol_comp_results_dir, zol_full_results_dir, cgc_results_dir, zol_parameters, zol_high_quality_preset, zol_edge_distance, zol_keep_multi_copy, threads, multi_thread, parallel_jobs_4thread, logObject)
		pathlib.Path(step_7_checkpoint_file).touch()

	# Step 8: Running GSeeF, lsaBGC-See and lsaBGC-ComprehenSeeIve
	msg = '--------------------\nStep 8: Running GSeeF, lsaBGC-See, and lsaBGC-ComprehenSeeIve analyses\n--------------------'
	sys.stderr.write(msg + '\n')
	logObject.info(msg)
	step_8_checkpoint_file = check_dir + 'Step_8.txt'
	gseef_dir = visual_results_dir + 'GSeeF_Results/'
	see_dir = visual_results_dir + 'lsaBGC_See_Results/'
	compsee_dir = visual_results_dir + 'lsaBGC_ComprehenSeeIve_Results/'
	if not os.path.isfile(step_8_checkpoint_file):
		util.setupReadyDirectory([see_dir, compsee_dir])
		lsabgc_gseef_stdout_file = log_dir + 'GSeeF.stdout.txt'
		lsabgc_gseef_stderr_file = log_dir + 'GSeeF.stderr.txt'	
		gseef_cmd = ['GSeeF', '-g', detailed_BGC_listing_with_Pop_and_GCF_map_file, '-s', species_tree_file, '-o', gseef_dir]
		util.runCmdViaSubprocess(gseef_cmd, logObject=logObject, check_directories=[gseef_dir],
								 stdout=lsabgc_gseef_stdout_file, stderr=lsabgc_gseef_stderr_file)
		util.runSeeAndComprehenSeeIve(detailed_BGC_listing_with_Pop_and_GCF_map_file, species_tree_file, ortholog_matrix_file, 
									  see_dir, compsee_dir, threads, logObject)
		pathlib.Path(step_8_checkpoint_file).touch()

	# Step 9: Running lsaBGC-MIBiGMapper
	msg = '--------------------\nStep 9: Parallel running of lsaBGC-MIBiGMapper\n--------------------'
	sys.stderr.write(msg + '\n')
	logObject.info(msg)
	step_9_checkpoint_file = check_dir + 'Step_9.txt'
	mibig_dir = outdir + 'lsaBGC_MIBiG-Mapper/'
	if not os.path.isfile(step_9_checkpoint_file):
		util.setupReadyDirectory([mibig_dir])
		util.runMIBiGMapper(detailed_BGC_listing_with_Pop_and_GCF_map_file, ortholog_matrix_file, mibig_dir, 
							multi_thread, parallel_jobs_4thread, logObject)
		pathlib.Path(step_9_checkpoint_file).touch()

	# Step 10: Parallel running of lsaBGC-Reconcile (for horizontal transfer assessment)
	msg = '--------------------\nStep 10: Running lsaBGC-Reconcile\n--------------------'
	sys.stderr.write(msg + '\n')
	logObject.info(msg)
	step_10_checkpoint_file = check_dir + 'Step_10.txt'
	recon_dir = visual_results_dir + 'lsaBGC_Reconcile_Results/'
	recon_scratch_dir = scratch_dir + 'lsaBGC_Reconcile_Scratch/'
	recon_result_file = recon_dir + 'Orthogroup_Summary_Info.txt'
	recon_og_result_file = recon_dir + 'Orthogroup_by_Sample_Copy_Count.txt'
	recon_pop_color_file = recon_scratch_dir + 'pop_colors_mapping.txt'
	if not os.path.isfile(step_10_checkpoint_file):
		util.setupReadyDirectory([recon_dir, recon_scratch_dir])
		
		lsabgc_reconcile_cmd = ['lsaBGC-Reconcile', '-l', detailed_BGC_listing_with_Pop_and_GCF_map_file, '-m', 
								ortholog_matrix_file, '-s', species_tree_file, '-o', recon_dir, '-sd', 
								recon_scratch_dir, '-c', str(threads), '-t', str(alignment_timeout)]
		if high_quality_reconcile_flag:
			lsabgc_reconcile_cmd += ['-q']
		lsabgc_reconcile_stdout_file = log_dir + 'lsaBGC-Reconcile.stdout.txt'
		lsabgc_reconcile_stderr_file = log_dir + 'lsaBGC-Reconcile.stderr.txt'
		util.runCmdViaSubprocess(lsabgc_reconcile_cmd, logObject=logObject, check_files=[recon_result_file, 
																						 recon_og_result_file,
																						 recon_pop_color_file],
																						 stdout=lsabgc_reconcile_stdout_file,
																						 stderr=lsabgc_reconcile_stderr_file)
		pathlib.Path(step_10_checkpoint_file).touch()
	
	# Step 11: Parallel running of lsaBGC-Sociate
	msg = '--------------------\nStep 11: Running lsaBGC-Sociate\n--------------------'
	sys.stderr.write(msg + '\n')
	logObject.info(msg)
	step_11_checkpoint_file = check_dir + 'Step_11.txt'
	sociate_dir = outdir + 'lsaBGC_Sociate_Results/'
	visual_sociated_dir = visual_results_dir + 'lsaBGC_Sociate_Visual_Results/'
	sociate_result_file = sociate_dir + 'Final_Sociated_Results.tsv'
	if not os.path.isfile(step_11_checkpoint_file):
		lsabgc_sociate_cmd = ['lsaBGC-Sociate', '-l', detailed_BGC_listing_with_Pop_and_GCF_map_file, '-m', 
								ortholog_matrix_file, '-s', species_tree_file, '-o', sociate_dir,
								'-vo', visual_sociated_dir, '-c', str(threads), '-t', str(alignment_timeout)]
		if report_sociate_hits_flag:
			lsabgc_sociate_cmd += ['-r']
		lsabgc_sociate_stdout_file = log_dir + 'lsaBGC-Sociate.stdout.txt'
		lsabgc_sociate_stderr_file = log_dir + 'lsaBGC-Sociate.stderr.txt'
		util.runCmdViaSubprocess(lsabgc_sociate_cmd, logObject=logObject, check_files=[sociate_result_file],
								 stdout=lsabgc_sociate_stdout_file, stderr=lsabgc_sociate_stderr_file)
		pathlib.Path(step_11_checkpoint_file).touch()

	# Step 12: Create consolidated report of zol, lsaBGC-MIBiGMapper, lsaBGC-Reconcile, and lsaBGC-Sociate results
	msg = '--------------------\nStep 12: Creating final spreadsheet with all the major results!\n--------------------'
	sys.stderr.write(msg + '\n')
	logObject.info(msg)

	final_spreadsheet_xlsx = final_dir + 'Consolidated_Spreadsheets.xlsx'
	util.createFinalSpreadsheets(detailed_BGC_listing_with_Pop_and_GCF_map_file, zol_results_dir, zol_high_quality_preset,
								 mibig_dir, recon_result_file, recon_og_result_file, recon_pop_color_file,
								 sociate_result_file, final_spreadsheet_xlsx, scratch_dir, logObject)

	# Close logging object and exit
	msg = 'lsaBGC-Pan completed! Check out the major results in the folder: %s' % final_dir
	logObject.info(msg)
	sys.stdout.write(msg + '\n')
	util.closeLoggerObject(logObject)
	sys.exit(0)

