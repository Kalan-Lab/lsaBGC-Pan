def checkOrthoFinderSetup(required_by=None):
	"""
	Check that OrthoFinder runs (e.g. its "#!/usr/bin/env python3" shebang can resolve to a python which lacks its
	dependencies, like scipy, if another python is found earlier on PATH). Exits with guidance if it does not work.
	- required_by: name of the tool which runs OrthoFinder internally (e.g. bofasa), if not run directly.
	"""
	problem = None
	if shutil.which('orthofinder') is None:
		problem = 'The orthofinder executable could not be found on PATH.'
	else:
		try:
			of_test = subprocess.run(['orthofinder', '-h'], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=300)
			of_test_out = of_test.stdout.decode('utf-8', errors='replace')
			# a non-zero exit or traceback indicates a broken install / python environment.
			if of_test.returncode != 0 or 'Traceback (most recent call last)' in of_test_out:
				problem = 'Running "orthofinder -h" failed with:\n' + '\n'.join(of_test_out.strip().split('\n')[-5:])
		except Exception as e:
			problem = 'Running "orthofinder -h" failed with: %s' % str(e)

	if problem is not None:
		requirement = ''
		if required_by is not None:
			requirement = '%s was requested, which runs OrthoFinder internally, but OrthoFinder' % required_by
		else:
			requirement = 'OrthoFinder'
		sys.stderr.write("""
[ERROR] %s was not installed (properly) or set up correctly! 

%s

> Set the bin/ folder in your conda environment to have the highest priority for path lookup:
$ export PATH=$CONDA_PREFIX/bin:$PATH

> Then, test if you are able to see the help message for OrthoFinder without errors:
$ orthofinder -h

Finally, please try re-running lsaBGC-Pan again!
""" % (requirement, problem))
		sys.exit(1)


def checkZolVersion(minimum_version='1.8.0'):
	"""
	Check that the installed zol is at least the minimum version lsaBGC-Pan is written for. Exits with guidance if not.
	"""
	try:
		from importlib.metadata import version as package_version
		zol_version = package_version('zol')
	except Exception:
		sys.stderr.write('[ERROR] zol does not appear to be installed in this environment, please install zol >= %s!\n' % minimum_version)
		sys.exit(1)
	def version_tuple(v):
		return tuple(int(''.join(c for c in x if c.isdigit()) or 0) for x in v.split('.')[:3])
	if version_tuple(zol_version) < version_tuple(minimum_version):
		sys.stderr.write("""
[ERROR] zol version %s is installed, but lsaBGC-Pan requires zol >= %s! 

> Please update zol in your lsaBGC-Pan conda environment:
$ conda install -c conda-forge -c bioconda "zol>=%s"

Then, please try re-running lsaBGC-Pan again!
""" % (zol_version, minimum_version, minimum_version))
		sys.exit(1)


def create_parser():
	""" Parse arguments """
	parser = ArgumentParser(description="""
       __              ___   _____  _____
      / /  ___ ___ _  / _ ) / ___/ / ___/
     / /  (_-</ _ `/ / _  |/ (_ / / /__  
    /_/  /___/\\_,_/ /____/ \\___/  \\___/  
    **********************************************************************************************************
    Program: lsaBGC-Pan
    Author: Rauf Salamzade
    Affiliation: Kalan Lab, UW Madison, Department of Medical Microbiology and Immunology
	
    QUICK DESCRIPTION:
    Workflow to run a pan-genome analysis of biosynthetic gene clusters for a single genus or species. 
    https://github.com/Kalan-Lab/lsaBGC-Pan/
		
    **********************************************************************************************************
    NOTES & CONSIDERATIONS:	

    * Check out the documentation at: https://github.com/Kalan-Lab/lsaBGC-Pan/wiki 	
    * Either provide an antiSMASH results directory or a directory with genomes (not both!).
    * lsaBGC-Pan does not have all the functionalities of the original lsaBGC suite to make things simpler 
      and more straightforward. In particular, lsaBGC-(Auto)Expansion, which helped with scalability is 
      excluded because its usage generally requires more careful consideration and manual curation. Thus, to 
      make sure your analysis runs in a relatively timely manner, the program is restricted to handling data 
      from 4-200 genomes.
          - Consider using tools for dereplication/strain-clustering (such as skDER/CiDDER, dRep, PopPunk, 
            or treemmer) to prune down your set of genomes if you have more than 200.
          - Alternatively, the upper limit can be lifted with --ignore-upperbound-limit (-x).
    * By default, bofasa (https://github.com/raufs/bofasa) is used for orthology inference. It is designed for 
      orthology inference across multiple bacterial species and prioritizes accuracy over speed. It requires the 
      bofasa databases to be set up beforehand (run "bofasa setup" and make sure the BOFASA_DB_PATH environment 
      variable is set).
    * Panaroo (--use-panaroo) can be used instead, but should only be used if working with genomes belonging to 
      a single bacterial species. OrthoFinder can also be requested explicitly (--use-orthofinder).
    * Specifying fungal mode makes sure OrthoFinder is being used and that antiSMASH results were provided. 
      GECCO is not designed for fungal genomes. In addition, customized processing designed for bacterial 
      genomics is not performed and a more direct extraction of hierarchical orthogroups is applied.
	* Precomputed GECCO results (e.g. from nf-core/funcscan) can be provided with --precomputed-gecco-directory
	  together with the genomes (-g) GECCO was run on. The directory should contain one subdirectory per 
	  sample - named exactly as the genome FASTA file (minus extension) - with the GECCO "run" results 
	  (*.clusters.tsv and cluster GenBank files) for that genome. lsaBGC-Pan still performs its own gene-calling 
	  and recreates BGC GenBank files from it using the GECCO BGC coordinates, types, and domain annotations.
	  Scaffold names and sequences are validated to make sure GECCO results correspond to the genomes provided.
	* The name of the sample-specific antiSMASH results directory will be used as the sample name, not the 
	  name of the full-genome GenBank file within it. So the sample name will be controlled by the antiSMASH 
	  argument --output-dir and not --output-basename.

    **********************************************************************************************************
    OVERVIEW OF WORKFLOW STEPS:	
	
    PART 1
    ----------------------------------------------------------------------------------------------------------
        - Step 1: Assess inputs provided
        - Step 1a: If genomes are provided, perform gene-calling with p(y)rodigal and annotate BGCs with GECCO
                   (or use precomputed GECCO results if provided)
        - Step 1b: If antiSMASH results are provided, extract genes from full genome GenBank files. If GECCO 
                   is requested, then it will also be run and overlapping GECCO and antiSMASH BGC regions will 
                   be consolidated by taking the larger region. 
        - Step 2: Run bofasa (default), Panaroo, or OrthoFinder (fungal mode) for orthology inference.
        - Step 3: Create species tree/phylogeny from (near-) core ortholog groups.
        - Step 4: Infer populations (will do so at multiple "core AAI" cutoffs) [no checkpoint, always rerun].
        - Step 5: Run lsaBGC-Cluster to determine evolutionary GCFs (first in parameter-testing mode to assess 
                  clustering parameters, followed by the final clustering with the specified parameters) 
                  [no checkpoint, always rerun].
		
    BREAK (optional - but recommended - can be skipped by issuing --no-break)
    ----------------------------------------------------------------------------------------------------------
        - Step 6a: Manually examine which parameters make the most sense for evolutionary clustering of GCFs. 
                   Afterwards, restart the workflow with the gene cluster clustering parameters adapted.
        - Step 6b: Manually assess how population designations structure along the species tree with different 
                   core AAI cutoffs and, if desired, adjust population designations.							  

    PART 2
    ----------------------------------------------------------------------------------------------------------
        - Step 7: Parallel running of zol and cgc per GCF.
        - Step 8: Parallel running of GSeeF, lsaBGC-See, and lsaBGC-ComprehenSeeIve per GCF.
        - Step 9: Parallel running of lsaBGC-MIBiGMapper.
        - Step 10: Run lsaBGC-Reconcile.
		- Step 11: Run lsaBGC-Sociate.
        - Step 12: Create consolidated report of zol, lsaBGC-MIBiGMapper, lsaBGC-Reconcile, and lsaBGC-Sociate 
                   results [no checkpoint, always rerun].
    **********************************************************************************************************
	""", formatter_class = RawTextRichHelpFormatter)

	parser.add_argument('-a', '--antismash-results-directory', help="A directory with subdirectories corresponding to antiSMASH results\nper sample/genome [Optional].", required=False, default=None)
	parser.add_argument('-g', '--genomes', nargs='+', help="Paths to genomes or directories with genomes in FASTA format.\nWill run GECCO for BGC-predictions [Optional].", required=False, default=[])
	parser.add_argument('-pg', '--precomputed-gecco-directory', help="A directory with subdirectories corresponding to precomputed GECCO\nresults per sample/genome. Requires genomes GECCO was run on to\nalso be provided via -g/--genomes [Optional].", required=False, default=None)
	parser.add_argument('-o', '--output-directory', help="Parent output/workspace directory.", required=True)

	parser.add_argument('-f', '--fungal', action='store_true', help="Specify if input are from fungal genomes. Only possible\nif antiSMASH results are provided.", required=False, default=False)
	parser.add_argument('-k', '--keep-locus-tags', action='store_true', help="Attempt to keep original locus tags in antiSMASH GenBank\nfiles - if locus tag is missing for one or more CDS\nfeatures new ones will be generated for the sample (experimental).", required=False, default=False)
	parser.add_argument('-rg', '--run-gecco', action='store_true', help="If antiSMASH results are provided also run GECCO for\nannotation of BGCs.", required=False, default=False)

	parser.add_argument('-up', '--use-panaroo', action='store_true', help='Use Panaroo instead of bofasa (the default) for orthology inference.\nRecommended only if investigating a single bacterial species.', default=False, required=False)
	parser.add_argument('-uo', '--use-orthofinder', action='store_true', help='Use OrthoFinder instead of bofasa (the default) for orthology\ninference. Automatically used in fungal mode.', default=False, required=False)
	parser.add_argument('-brs', '--bofasa-rooting-seeds', type=int, help='The maximum number of nodes bofasa tries for rooting (passed to\n"bofasa run -rs"); a random sampling is performed. Only applies\nwhen bofasa is used [Default is 1; uses midpoint rooting].', required=False, default=1)
	parser.add_argument('-omc', '--run-coarse-orthofinder', action='store_true', help='Use coarse clustering for orthogroups in OrthoFinder (if used) instead\nof the more resolute hierarchical determined homolog groups.\nThere are some advantages to coarse OGs, including their\nconstruction being deterministic.', required=False, default=False)
	parser.add_argument('-ohq', '--run-msa-orthofinder', action='store_true', help='Run OrthoFinder using multiple sequence alignments instead of\nDendroBlast to determine hierarchical ortholog groups.', required=False, default=False)

	parser.add_argument('-hqp', '--high-quality-phylogeny', action='store_true', help='Prioritize quality over speed for phylogeny construction.', required=False, default=False)
	parser.add_argument('-cs', '--core-proportion', type=float, help='What proportion of genomes single-copy orthogroups need to be\nfound in to be used for species tree construction [Default is 0.9].', required=False, default=0.90)
	parser.add_argument('-mcs', '--max-core-genes', type=int, help="The maximum number of single copy (near-)core orthogroups to\nuse [Default is 500].", required=False, default=500)

	parser.add_argument('-pic', '--population-identity-cutoff', type=float, help='The core-genome identity cutoff used to define pairs of genomes as\nbelonging to the same group/population [Default is 99.0].', required=False, default=99.0)
	parser.add_argument('-mpf', '--manual-populations-file', help="Tab delimited file for manual mapping of samples to different\npopulations/clades.", required=False, default=None)

	parser.add_argument('-ci', '--cluster-inflation', type=float, help='The MCL inflation parameter for clustering BGCs into GCFs [Default\nis 0.8].', required=False, default=0.8)
	parser.add_argument('-cj', '--cluster-jaccard', type=float, help="Cutoff for Jaccard similarity of homolog groups shared between two\nBGCs [Default is 50.0].", required=False, default=50.0)
	parser.add_argument('-cr', '--cluster-syntenic-correlation', type=float, help='The minimal absolute correlation coefficient of gene order (for single-copy\northogroups shared, at least 3 needed) between two BGCs required for\nconsidering them as a pair prior to MCL [Default is 0.4].', required=False, default=0.4)
	parser.add_argument('-cc', '--cluster-containment', type=float, help="Cutoff for percentage of OGs for a gene cluster near a contig edge\nto be found within the comparing gene cluster for the pair to be\nconsidered in MCL (the syntenic correlation cutoff must still be met) [Default\nis 70.0]", required=False, default=70.0)

	parser.add_argument('-x', '--ignore-upperbound-limit', action='store_true', help='Allow analysis of more than 200 genomes (also passes --ignore-upperbound-limit\nto bofasa if it is used). Runtime and memory can grow substantially, consider\ndereplicating genomes (e.g. with skDER/CiDDER) first.', required=False, default=False)
	parser.add_argument('-y', '--yes', '--resume', dest='yes', action='store_true', help='Automatically continue (resume) if the output directory already exists\ninstead of prompting - checkpoint files will be used to skip completed\nsteps. Needed for resuming in non-interactive settings (e.g. Docker\nor batch jobs), such as after the break following step 5.', required=False, default=False)
	parser.add_argument('-nb', '--no-break', action='store_true', help='No break after step 5 to assess GCF clustering and population\nstratification and adapt parameters.', required=False, default=False)

	parser.add_argument('-zp', '--zol-parameters', help="The parameters to run zol analyses with - please surround by quotes,\ne.g. \"-am muscle\" (requires zol >= 1.8.0) [Default is \"\"].", default="")
	parser.add_argument('-zhq', '--zol-high-quality-preset', action='store_true', help='Use preset of options for performing high-quality and comprehensive zol\nanalyses instead of prioritizing speed (runs zol with: -am muscle -s -b).')
	parser.add_argument('-zl', '--zol-keep-multi-copy', action='store_true', help='Include all GCF instances in zol analysis, not just the most\nrepresentative instance from each sample/genome.', required=False, default=False)
	
	parser.add_argument('-ed', '--edge-distance', type=int, help="Distance in bp to scaffold/contig edge to be considered potentially\nfragmented. Used in GCF clustering (related to --cluster-containment\nparameter) and zol conservation computations [Default is 5000].", required=False, default=5000)
	# considering adding future argument for focal population definition in zol based on ID determined by popstrat

	parser.add_argument('-hqr', '--high-quality-reconcile', action='store_true', help="Perform high-quality alignment for reconcile analysis.", required=False, default=False)
	parser.add_argument('-rash', '--report-all-sociate-hits', action='store_true', help="Report all significant pyseer hits with 'notes' - usually\nindicate some general issue - should be examined with caution:\nhttps://pyseer.readthedocs.io/en/master/usage.html#notes-field.", required=False, default=False)
	parser.add_argument('-at', '--alignment-timeout', type=float, help="The timeout in seconds for constructing protein alignments using\nMUSCLE during lsaBGC-Reconcile and lsaBGC-Sociate - to prevent long\nruns due to stragglers/abnormally large orthogroups [Default is\n1800 (30 minutes)].", required=False, default=1800)

	parser.add_argument('-py', '--use-prodigal', action='store_true', help='Use prodigal instead of pyrodigal (only if genomes are provided - not\nrelevant if antiSMASH results provided).', required=False, default=False)
	parser.add_argument('-c', '--threads', type=int, help="Total number of threads/processes to use. Recommend increasing as much\nas possible. [Default is 4].", required=False, default=4)
	parser.add_argument('-d', '--docker-mode', action='store_true', help=argparse.SUPPRESS, required=False, default=False)
	
	args = parser.parse_args()
	return args

def lsaBGC():
	version_string = util.parseVersion()
	if '-v' in sys.argv or '--version' in sys.argv:
		logo = """
   __              ___   _____  _____
  / /  ___ ___ _  / _ ) / ___/ / ___/
 / /  (_-</ _ `/ / _  |/ (_ / / /__  
/_/  /___/\\_,_/ /____/ \\___/  \\___/  
*************************************"""
		sys.stdout.write(logo + '\n\n')
		sys.stdout.write('Running lsaBGC-Pan version %s\n' % version_string)
		sys.exit(0)

	myargs = create_parser()

	# make sure dependencies resolve to this conda environment's executables (and python) first
	util.prioritizeEnvironmentBinPath()

	### PARSE OPTIONS
	antismash_directory = myargs.antismash_results_directory
	genome_inputs = myargs.genomes
	precomputed_gecco_directory = myargs.precomputed_gecco_directory
	outdir = os.path.abspath(myargs.output_directory) + '/'

	fungal_flag = myargs.fungal
	run_gecco_flag = myargs.run_gecco
	use_prodigal = myargs.use_prodigal
	no_break_flag = myargs.no_break
	keep_lt_flag = myargs.keep_locus_tags
	ignore_upperbound_limit_flag = myargs.ignore_upperbound_limit
	max_genomes = None if ignore_upperbound_limit_flag else 200

	use_panaroo_flag = myargs.use_panaroo
	use_orthofinder_flag = myargs.use_orthofinder
	bofasa_rooting_seeds = myargs.bofasa_rooting_seeds
	run_coarse_orthofinder_flag = myargs.run_coarse_orthofinder
	run_msa_orthofinder_flag = myargs.run_msa_orthofinder
	
	cluster_inflation_param = myargs.cluster_inflation 
	cluster_jaccard_param = myargs.cluster_jaccard
	cluster_syntenic_correlation = myargs.cluster_syntenic_correlation
	cluster_containment = myargs.cluster_containment

	high_quality_phylogeny_flag = myargs.high_quality_phylogeny
	phylogeny_core_proportion = myargs.core_proportion
	max_core_genes = myargs.max_core_genes
	population_identity_cutoff = myargs.population_identity_cutoff
	manual_populations_file = myargs.manual_populations_file

	zol_parameters = myargs.zol_parameters
	zol_high_quality_preset = myargs.zol_high_quality_preset
	zol_edge_distance = myargs.edge_distance
	zol_keep_multi_copy = myargs.zol_keep_multi_copy
	
	high_quality_reconcile_flag = myargs.high_quality_reconcile
	report_sociate_hits_flag = myargs.report_all_sociate_hits
	alignment_timeout = myargs.alignment_timeout

	threads = myargs.threads
	docker_mode_flag = myargs.docker_mode
	auto_yes_flag = myargs.yes

	raw_genome_files = []
	raw_genomes_provided = False
	for gi in genome_inputs:
		if os.path.isfile(gi):
			if util.is_fasta(gi):
				raw_genome_files.append(os.path.abspath(gi))
			else:
				msg = 'Unable to validate the file %s is in FASTA format, skipping' % gi
				sys.stderr.write(msg + '\n')
		elif os.path.isdir(gi):
			genome_dir = os.path.abspath(gi) + '/'
			for f in os.listdir(genome_dir):
				genome_file = genome_dir + f
				if os.path.isfile(genome_file):
					if util.is_fasta(genome_file):
						raw_genome_files.append(genome_dir + f)
					else:
						msg = 'Unable to validate the file %s is in FASTA format, skipping' % genome_file
						sys.stderr.write(msg + '\n')
		else:
			msg = 'Unable to validate %s as a file or directory, skipping' % gi
			sys.stderr.write(msg + '\n')
		if len(raw_genome_files) > 0:
			raw_genomes_provided = True

	# External programs are run through the shell, so whitespace or shell special characters in paths of the output
	# directory or antiSMASH results (which are referenced directly in commands) would break commands.
	for path_label, path_value in [['output directory (-o)', outdir], ['antiSMASH results directory (-a)', antismash_directory]]:
		if path_value == None: continue
		unsafe_chars = sorted(set(os.path.abspath(path_value)).intersection(util.SHELL_UNSAFE_CHARACTERS))
		if len(unsafe_chars) > 0:
			msg = 'The path to the %s contains whitespace or special characters (%s) which are not supported because they break external commands: %s\nPlease use a path without such characters.' % (path_label, ' '.join([repr(c) for c in unsafe_chars]), os.path.abspath(path_value))
			sys.stderr.write(msg + '\n')
			sys.exit(1)

	if antismash_directory != None and not os.path.isdir(antismash_directory):
		msg = 'The antiSMASH results directory provided does not exist: %s' % antismash_directory
		sys.stderr.write(msg + '\n')
		sys.exit(1)
	if antismash_directory == None and not raw_genomes_provided:
		msg = 'No valid input provided! Please provide either an antiSMASH results directory (-a) or genomes in FASTA format (-g).'
		sys.stderr.write(msg + '\n')
		sys.exit(1)

	if (antismash_directory != None and os.path.isdir(antismash_directory)) and raw_genomes_provided == True:
		msg = 'Both directories of antiSMASH results and genomes provided. This is not allowed currently - if you want a joint antiSMASH and GECCO analysis - just provide the antiSMASH results and specify the argument --run-gecco.'
		sys.stderr.write(msg + '\n')
		sys.exit(1)
	elif (antismash_directory != None and os.path.isdir(antismash_directory)):
		antismash_directory = os.path.abspath(antismash_directory) + '/'
		msg = 'antiSMASH results directory provided: %s' % antismash_directory
		sys.stderr.write(msg + '\n')
	elif (raw_genomes_provided == True):
		msg = 'Raw genomes provided: %s' % raw_genome_files
		sys.stderr.write(msg + '\n')

	if precomputed_gecco_directory != None:
		if not os.path.isdir(precomputed_gecco_directory):
			msg = 'Precomputed GECCO results directory %s does not exist.' % precomputed_gecco_directory
			sys.stderr.write(msg + '\n')
			sys.exit(1)
		if not raw_genomes_provided or antismash_directory != None:
			msg = 'Precomputed GECCO results can only be used together with genomes provided via -g/--genomes (the same genome FASTA files GECCO was run on) and not with antiSMASH results.'
			sys.stderr.write(msg + '\n')
			sys.exit(1)
		if fungal_flag:
			msg = 'Precomputed GECCO results cannot be used in fungal mode.'
			sys.stderr.write(msg + '\n')
			sys.exit(1)
		precomputed_gecco_directory = os.path.abspath(precomputed_gecco_directory) + '/'
		msg = 'Precomputed GECCO results directory provided: %s' % precomputed_gecco_directory
		sys.stderr.write(msg + '\n')

	if os.path.isdir(outdir):
		if auto_yes_flag:
			sys.stderr.write("Output directory already exists! --yes/--resume specified, so continuing and overwriting where needed (will use checkpoint files to skip certain steps)...\n")
		elif not sys.stdin.isatty():
			sys.stderr.write("Output directory already exists, but this appears to be a non-interactive session (e.g. Docker or a batch job), so the user cannot be prompted to confirm continuing.\nTo resume using checkpoint files (e.g. after the break following step 5), please re-run with the -y/--yes (or --resume) flag. Exiting.\n")
			sys.exit(1)
		else:
			try:
				response = input("Output directory already exists! Would you like to continue and overwrite files where needed (will use checkpoint files to skip certain steps)? [y/n]: ")
				if response.lower() not in ['y', 'yes']:
					sys.stderr.write("Exiting.\n")
					sys.exit(0)
				sys.stderr.write("Continuing and overwriting where needed...\n")
			except (EOFError, KeyboardInterrupt):
				sys.stderr.write("\nNon-interactive session or user interrupt. To resume without being prompted, re-run with the -y/--yes (or --resume) flag. Exiting.\n")
				sys.exit(1)
	else:
		util.setupReadyDirectory([outdir])

	# create logging object
	log_file = outdir + 'Progress.log'
	logObject = util.createLoggerObject(log_file)
	parameters_file = outdir + 'Command_Issued.txt'
	logo = """
   __              ___   _____  _____
  / /  ___ ___ _  / _ ) / ___/ / ___/
 / /  (_-</ _ `/ / _  |/ (_ / / /__  
/_/  /___/\\_,_/ /____/ \\___/  \\___/  
*************************************"""
	sys.stdout.write(logo + '\n\n')
