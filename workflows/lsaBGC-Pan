	logObject.info('Running version %s' % version_string)
	logObject.info("Appending command issued for future records to: %s" % parameters_file)

	with open(parameters_file, 'a+') as parameters_handle:
		parameters_handle.write(' '.join(sys.argv) + '\n')

	# Determine the orthology inference method: bofasa (default), Panaroo (--use-panaroo), or OrthoFinder
	# (--use-orthofinder or fungal mode).
	if use_panaroo_flag and use_orthofinder_flag:
