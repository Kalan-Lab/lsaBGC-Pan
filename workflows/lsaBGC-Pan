	orthology_method = 'bofasa'
	if use_panaroo_flag:
		orthology_method = 'panaroo'
	elif use_orthofinder_flag:
		orthology_method = 'orthofinder'

	if fungal_flag:
		if orthology_method != 'orthofinder':
			if use_panaroo_flag:
