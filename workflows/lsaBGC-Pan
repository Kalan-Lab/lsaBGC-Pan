		os.environ["GECCO_DOMAIN_WEIGHTS_PKL_FILE"] = gw_pkl

	if orthology_method != 'orthofinder' and (run_coarse_orthofinder_flag or run_msa_orthofinder_flag):
		msg = 'Warning: --run-coarse-orthofinder / --run-msa-orthofinder only apply when OrthoFinder is used for orthology inference (--use-orthofinder or fungal mode), ignoring them.'
		sys.stderr.write(msg + '\n')
		logObject.warning(msg)

	msg = 'Using %s for orthology inference.' % {'bofasa': 'bofasa', 'panaroo': 'Panaroo', 'orthofinder': 'OrthoFinder'}[orthology_method]
	sys.stdout.write(msg + '\n')
	logObject.info(msg)

	# dependency checks for the orthology inference method are skipped if orthology inference was already completed
