import os
import sys
from time import sleep
import argparse
from lsaBGC import util
from lsaBGC import phyloplot
import warnings
import traceback
from Bio import SeqIO
from collections import defaultdict
import math
import concurrent.futures

warnings.filterwarnings('ignore')

def create_parser():
	""" Parse arguments """
	parser = argparse.ArgumentParser(description="""
	Program: lsaBGC-Sociate
	Author: Rauf Salamzade
	Affiliation: Kalan Lab, UW Madison, Department of Medical Microbiology and Immunology

	This program runs pyseer (Lees, Galardini et al. 2018) to assess co-occurrence associations
    or dissociations between orthogroups found in BGC contexts and other orthogroups found 
    across genomes.                  
    
    Draws inspiration from the software/studies: 
      - Coinfinder by Whelan et al. 2020
      - Study by Bruns et al. 2017
      - Study by Beavan, Domingo-Sananes, and McInerney et al. 2023
      - Study by Mohite et al. 2022
      - Goldfinder by Gavriilidou, Paulitz and Resl et al. 2024     
      - Study by Wang, Chen, and Cruz-Morales et al. 2024                                  
    """, formatter_class=argparse.RawTextHelpFormatter)

	parser.add_argument('-l', '--lsabgc_detailed_listing', help='lsaBGC-Pan detailed listing with GCF and population structure information.', required=True)
	parser.add_argument('-m', '--orthomatrix', help='OrthoFinder/Panaroo/bofasa ortholog by sample matrix.', required=True)
	parser.add_argument('-o', '--output_directory', help="Output directory.", required=True)
	parser.add_argument('-vo', '--visual_output_directory', help="Visual output directory.", required=True)
	parser.add_argument('-s', '--species_phylogeny', help="The species phylogeny in Newick format.", required=True)
	parser.add_argument('-r', '--report_hits_with_notes', action='store_true', help="Report hits with pyseer 'notes' other than 'bad-chisq' (e.g.\nlrt-filtering-failed). The 'bad-chisq' note only concerns pyseer's\nunadjusted chi-squared pre-filter (the filter-pvalue column) and not\nthe LMM likelihood-ratio p-value used for significance, so hits with\nonly that note are always reported.", required=False, default=False)
	parser.add_argument('-tm', '--threshold_mode', choices=['global', 'per-gcf'], help="How to set the Bonferroni significance threshold [Default is global]:\n  global  - alpha divided by the total number of unique presence/absence\n            patterns tested, summed over every focal GCF and feature\n            type (OG or GCF).\n  per-gcf - alpha divided by the number of unique patterns tested for\n            the given focal GCF and feature type.\nPatterns are counted as unique within each focal GCF's tests because\northogroups with identical presence/absence profiles are redundant tests\n(as recommended by pyseer).", required=False, default='global')
	parser.add_argument('-a', '--alpha', type=float, help="Family-wise significance level prior to Bonferroni correction [Default\nis 0.05].", required=False, default=0.05)
	parser.add_argument('-c', '--threads', type=int, help="Number of threads to use [Default is 1].", required=False, default=1)
	parser.add_argument('-t', '--timeout_time', type=float, help="Timeout for alignments in seconds [Default is 1800].", required=False, default=1800)
	args = parser.parse_args()
	return args

def lsaBGC_Sociate():
	"""
    Void function which runs primary workflow for program.
    """

	"""
    PARSE REQUIRED INPUTS
    """
	myargs = create_parser()

	lsabgc_detailed_listing = os.path.abspath(myargs.lsabgc_detailed_listing)
	orthofinder_matrix_file = os.path.abspath(myargs.orthomatrix)
	outdir = os.path.abspath(myargs.output_directory) + '/'
	viz_outdir = os.path.abspath(myargs.visual_output_directory) + '/'
	report_hits_with_notes_flag = myargs.report_hits_with_notes
	threshold_mode = myargs.threshold_mode
	alpha = myargs.alpha
	if not (0.0 < alpha < 1.0):
		sys.stderr.write('Alpha (-a) must be between 0 and 1.\n')
		sys.exit(1)
	species_tree = os.path.abspath(myargs.species_phylogeny) 

	### vet input files quickly
	if not (os.path.isfile(orthofinder_matrix_file) and os.path.isfile(lsabgc_detailed_listing)):
		raise RuntimeError('One or more of the input files provided, does not exist. Exiting now ...')

	if os.path.isdir(outdir):
		sys.stderr.write("Output directory exists. Overwriting in 5 seconds ...\n ")
		sleep(5)

	util.setupReadyDirectory([outdir, viz_outdir])

	"""
    PARSE OPTIONAL INPUTS
    """

	threads = myargs.threads
	timeout_time = myargs.timeout_time

	parallel_jobs_4thread = max(math.floor(threads / 4), 1)
	multi_thread = 4
	if threads < 4:
		multi_thread = threads
		parallel_jobs_4thread = 1

	"""
    START WORKFLOW
    """
	# create logging object
	log_file = outdir + 'Progress.log'
	logObject = util.createLoggerObject(log_file)
	version_string = util.parseVersion()
	logObject.info('Running lsaBGC version %s' % version_string)

	# Log input arguments and update reference and query FASTA files.
	logObject.info("Saving parameters for future records.")
	parameters_file = outdir + 'Parameter_Inputs.txt'
	parameter_values = [lsabgc_detailed_listing, orthofinder_matrix_file, outdir, species_tree, report_hits_with_notes_flag,
						threshold_mode, alpha, threads]
	parameter_names = ["Detailed BGC Information File", "Ortholog by Sample Matrix File", "Output Directory",
					   "Species Phylogeny", "Report Hits with Notes (other than bad-chisq)", "Threshold Mode", "Alpha", "Threads"]
	util.logParametersToFile(parameters_file, parameter_names, parameter_values)
	logObject.info("Done saving parameters!")

	# Step 0: Download pyseer scripts 
	pyseer_script_dir = outdir + 'pyseer_scripts/'
	util.setupReadyDirectory([pyseer_script_dir])

	msg = 'Downloading pyseer script phylogeny_distance.py'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)
	
	# note: unique patterns (pyseer's count_patterns.py) are now counted directly below.
	pd_script = pyseer_script_dir + 'phylogeny_distance.py'
	curl_cmd = ['curl', '-L', 'https://raw.githubusercontent.com/mgalardini/pyseer/master/scripts/phylogeny_distance.py', '-o', pd_script]
	try:
		util.runCmdViaSubprocess(curl_cmd, logObject=logObject, check_files=[pd_script])
	except Exception as e:
		msg = 'Had issues downloading pyseer auxiliary scripts!'
		sys.stderr.write(msg + '\n')
		sys.stderr.write(traceback.format_exc() + '\n')
		logObject.error(msg)
		logObject.error(traceback.format_exc())
		sys.exit(1)

	# Step 1: Convert species tree to kinship-esque matrix
	kinship_matrix_file = outdir + 'Kinship_Matrix.txt'
	phylo_dist_cmd = ['python', pd_script, '--lmm', species_tree, '>', kinship_matrix_file]          
	try:
		util.runCmdViaSubprocess(phylo_dist_cmd, logObject=logObject, check_files=[kinship_matrix_file])
	except Exception as e:
		msg = 'Issue generating kinship matrix from species phylogeny using the command: %s' % phylo_dist_cmd
		sys.stderr.write(msg + '\n')
		sys.stderr.write(traceback.format_exc() + '\n')
		logObject.error(msg)
		logObject.error(traceback.format_exc())
		sys.exit(1)

	# Step 2: Create genotype matrix of ortholog groups presence/absence info 
	genotype_og_matrix_file = outdir + 'Genotype_Matrix_OGs.txt'
	lt_to_og = {}
	og_samples = defaultdict(set)
	all_samples = set([])
	all_samples_ordered = []
	with open(genotype_og_matrix_file, 'w') as gmf_og_handle, open(orthofinder_matrix_file) as oomf:
		for i, line in enumerate(oomf):
			line = line.strip('\n')
			ls = line.split('\t')
			if i == 0:
				gmf_og_handle.write('\t'.join(ls) + '\n')
				all_samples = set(ls[1:])
				all_samples_ordered = ls[1:]
			else:
				og = ls[0]
				printlist = [og]
				for j, lts in enumerate(ls[1:]):
					if lts.strip() == '':
						printlist.append('0')
					else:
						printlist.append('1')
						sample = all_samples_ordered[j]
						og_samples[og].add(sample)
						for lt in lts.split(', '):
							lt_to_og[lt] = og
				gmf_og_handle.write('\t'.join(printlist) + '\n')

	# Step 3: Create phenotype/genotype matrix of GCFs presence/absence info
	gcf_samples = defaultdict(set)
	all_gcfs = set([])
	gcf_ogs = defaultdict(set)
	og_gcfs = defaultdict(set)
	with open(lsabgc_detailed_listing) as oldlf:
		for i, line in enumerate(oldlf):
			if i == 0: continue
			line = line.strip()
			sample, population, method, genome_path, bgc_id, bgc_path, bgc_type, gcf_id, scaffold, start, end, bgc_length, dist_to_edge = line.split('\t')
			gcf_samples[gcf_id].add(sample)
			all_gcfs.add(gcf_id)
			with open(bgc_path) as obp:
				for rec in SeqIO.parse(obp, 'genbank'):
					for feat in rec.features:
						if feat.type != 'CDS': continue 
						lt = feat.qualifiers.get('locus_tag')[0]
						og = lt_to_og[lt]
						gcf_ogs[gcf_id].add(og)
						og_gcfs[og].add(gcf_id)

	genotype_gcf_matrix_file = outdir + 'Genotype_Matrix_GCFs.txt'
	with open(genotype_gcf_matrix_file, 'w') as ggm_gcf_handle:
		ggm_gcf_handle.write('GCFs\t' + '\t'.join(sorted(all_samples)) + '\n')
		gcfs_in_order = []
		for gcf in sorted(gcf_samples):
			gcfs_in_order.append(gcf)
			printlist = [gcf]
			for sample in sorted(list(all_samples)):
				if sample in gcf_samples[gcf]:
					printlist.append('1')
				else:
					printlist.append('0')
			ggm_gcf_handle.write('\t'.join(printlist) + '\n')

	# Step 4: Run Pyseer to infer associations between ortholog groups and GCFs and 
	#         between GCFs and GCFs.

	pyseer_results_dir = outdir + 'Pyseer_Results/'
	pyseer_patterns_dir = outdir + 'Pyseer_Patterns/'
	pyseer_thresh_dir = outdir + 'Pyseer_Thresholds/'
	pyseer_inputs_dir = outdir + 'Pyseer_Inputs/'

	util.setupReadyDirectory([pyseer_inputs_dir, pyseer_patterns_dir, pyseer_thresh_dir, pyseer_results_dir])

	pyseer_cmds = []
	for gcf in all_gcfs:
		
		# pyseer reads the phenotype file with a header line (pandas read_csv with index_col=0) - without one
		# the first sample would be consumed as the header and silently dropped from every association test.
		pheno_gcf_input = pyseer_inputs_dir + gcf + '.txt'
		with open(pheno_gcf_input, 'w') as pgi_handle:
			pgi_handle.write('samples\t' + gcf + '\n')
			for sample in sorted(all_samples):
				val = '0'
				if sample in gcf_samples[gcf]:
					val = '1'
				pgi_handle.write(sample + '\t' + str(val) + '\n')

		og_result_file = pyseer_results_dir + gcf + '_OG_Results.txt'
		og_pattern_file = pyseer_patterns_dir + gcf + '_OG_Patterns.txt'
		pyseer_og_cmd = ['pyseer', '--lmm', '--phenotypes', pheno_gcf_input, '--pres', 
						genotype_og_matrix_file, '--min-af', '0.05', '--max-af', '0.95', '--cpu', 
						'1', '--similarity', kinship_matrix_file, '--output-patterns', 
						og_pattern_file, '>', og_result_file]
		pyseer_cmds.append(pyseer_og_cmd)

		gcf_result_file = pyseer_results_dir + gcf + '_GCF_Results.txt'
		gcf_pattern_file = pyseer_patterns_dir + gcf + '_GCF_Patterns.txt' 
		pyseer_gcf_cmd = ['pyseer', '--lmm', '--phenotypes', pheno_gcf_input, '--pres', 
						genotype_gcf_matrix_file, '--min-af', '0.05', '--max-af', '0.95', '--cpu', 
						'1', '--similarity', kinship_matrix_file, '--output-patterns', 
						gcf_pattern_file, '>', gcf_result_file]
		pyseer_cmds.append(pyseer_gcf_cmd)

	try:
		with concurrent.futures.ThreadPoolExecutor(max_workers=threads) as executor:
			list(executor.map(util.multiProcessNoLog, pyseer_cmds))
	except Exception as e:
		msg = 'Issues running pyseer in parallel.\n'
		sys.stderr.write(msg)
		sys.stderr.write(traceback.format_exc())
		sys.exit(1)

	# Step 5: Determine significance thresholds based on the number of unique presence/absence patterns tested
	#         (equivalent to pyseer's count_patterns.py) and apply filtering.
	unique_patterns = defaultdict(lambda: defaultdict(int))
	raw_tests = 0
	for gcf in sorted(all_gcfs):
		for soc_type in ['OG', 'GCF']:
			pattern_file = pyseer_patterns_dir + gcf + '_' + soc_type + '_Patterns.txt'
			patterns = set([])
			if os.path.isfile(pattern_file):
				with open(pattern_file, 'rb') as opf:
					for line in opf:
						line = line.strip()
						if line:
							patterns.add(line)
							raw_tests += 1
			unique_patterns[gcf][soc_type] = len(patterns)

	total_unique_patterns = sum([unique_patterns[g][t] for g in unique_patterns for t in unique_patterns[g]])
	global_threshold = alpha / total_unique_patterns if total_unique_patterns > 0 else alpha
	gcf_pval_thresholds = defaultdict(dict)
	for gcf in sorted(all_gcfs):
		for soc_type in ['OG', 'GCF']:
			n_patterns = unique_patterns[gcf][soc_type]
			if threshold_mode == 'per-gcf':
				threshold = alpha / n_patterns if n_patterns > 0 else alpha
			else:
				threshold = global_threshold
			gcf_pval_thresholds[gcf][soc_type] = threshold
			with open(pyseer_thresh_dir + gcf + '_' + soc_type + '_Threshold_Info.txt', 'w') as tif_handle:
				tif_handle.write('Patterns:\t%d\n' % n_patterns)
				tif_handle.write('Threshold:\t%s\n' % str(threshold))
				tif_handle.write('Threshold mode:\t%s\n' % threshold_mode)

	if threshold_mode == 'per-gcf':
		msg = 'Applying per focal GCF and feature type Bonferroni-corrected significance thresholds (alpha of %s divided by the number of unique patterns tested; %d unique patterns across %d tests in total) to phylogenetically corrected p-values. Thresholds are listed in %s.' % (str(alpha), total_unique_patterns, raw_tests, pyseer_thresh_dir)
	else:
		msg = 'Applying a Bonferroni-corrected significance threshold of %s (alpha of %s across %d unique patterns tested, from %d tests in total) to phylogenetically corrected p-values.' % (str(global_threshold), str(alpha), total_unique_patterns, raw_tests)
	sys.stdout.write(msg + '\n')
	logObject.info(msg)

	hits = []
	sociated_ogs = set([])
	passing_threshold = 0
	removed_for_notes = 0
	for gcf in sorted(all_gcfs):
		for soc_type in ['OG', 'GCF']:
			result_file = pyseer_results_dir + gcf + '_' + soc_type + '_Results.txt'
			if not os.path.isfile(result_file): continue
			threshold = gcf_pval_thresholds[gcf][soc_type]
			with open(result_file) as orf:
				header_cols = None
				for i, line in enumerate(orf):
					line = line.strip('\n')
					ls = line.split('\t')
					if i == 0:
						header_cols = {c: idx for idx, c in enumerate(ls)}
						continue
					try:
						lrt_pval = float(ls[header_cols['lrt-pvalue']])
					except Exception:
						continue
					if not (lrt_pval <= threshold): continue
					genotype = ls[0]
					if genotype == gcf or genotype in gcf_ogs[gcf]: continue
					passing_threshold += 1

					notes = set([x for x in ls[header_cols['notes']].split(',') if x.strip() != ''])
					# 'bad-chisq' only pertains to the unadjusted chi-squared pre-test (filter-pvalue column) and is
					# nearly ubiquitous for datasets of tens of genomes - it does not invalidate the LMM LRT p-value.
					other_notes = notes - set(['bad-chisq'])
					if len(other_notes) > 0 and not report_hits_with_notes_flag:
						removed_for_notes += 1
						continue

					hits.append([gcf] + ls)
					sociated_ogs.add(genotype)

	msg = '%d associations passed the significance threshold; %d were removed for having pyseer notes other than bad-chisq, and %d are reported.' % (passing_threshold, removed_for_notes, len(hits))
	sys.stdout.write(msg + '\n')
	logObject.info(msg)

	# Step 6: Annotate associated/disassociated orthogroups
	soc_og_protseq_dir = outdir + 'Sociated_OG_Protein_Seqs/'
	soc_og_protalgn_dir = outdir + 'Sociated_OG_Protein_Alignments/'
	soc_og_hmm_dir = outdir + 'Sociated_OG_Protein_HMMs/'
	soc_og_consensus_dir = outdir + 'Sociated_OG_Protein_Consensus_Sequences/'
	util.setupReadyDirectory([soc_og_protseq_dir, soc_og_protalgn_dir, soc_og_hmm_dir, soc_og_consensus_dir])
	
	sample_genome_paths = {}
	with open(lsabgc_detailed_listing) as oldlf:
		for i, line in enumerate(oldlf):
			if i == 0: continue
			line = line.strip()
			sample, population, method, genome_path, bgc_id, bgc_path, bgc_type, gcf_id, scaffold, start, end, bgc_length, dist_to_edge = line.split('\t')
			gcf_samples[gcf_id].add(sample)
			all_gcfs.add(gcf_id)
			sample_genome_paths[sample] = genome_path

	# parse each genome only once to avoid writing duplicate protein entries for samples with multiple BGCs
	for sample in sorted(sample_genome_paths):
		genome_path = sample_genome_paths[sample]
		with open(genome_path) as ogp:
			for rec in SeqIO.parse(ogp, 'genbank'):
				for feat in rec.features:
					if feat.type != 'CDS': continue
					lt_list = feat.qualifiers.get('locus_tag')
					prot_list = feat.qualifiers.get('translation')
					if lt_list is None or prot_list is None: continue
					lt = lt_list[0]
					og = lt_to_og.get(lt)
					if og in sociated_ogs:
						prot_faa = soc_og_protseq_dir + og + '.faa'
						with open(prot_faa, 'a+') as pf_handle:
							pf_handle.write('>' + sample + '|' + lt + '\n' + prot_list[0] + '\n')

	muscle_cmds = []
	for og in sociated_ogs:
		if og.startswith('GCF'): continue
		og_prot_faa = soc_og_protseq_dir + og + '.faa'
		og_prot_msa = soc_og_protalgn_dir + og + '.msa.faa'

		muscle_cmd = ['muscle', '-super5', og_prot_faa, '-amino', '-output', og_prot_msa, '-threads', str(multi_thread), timeout_time]
		muscle_cmds.append(muscle_cmd)
	
	try:
		with concurrent.futures.ThreadPoolExecutor(max_workers=parallel_jobs_4thread) as executor:
			list(executor.map(util.multiProcessNoLogWithTimeout, muscle_cmds))
	except Exception as e:
		msg = 'Issues running muscle in parallel!\n'
		sys.stderr.write(msg)
		sys.stderr.write(traceback.format_exc())
		sys.exit(1)

	hmmbuild_cmds = []
	hmmemit_cmds = []
	annotation_notes = defaultdict(lambda: '')
	for og in sociated_ogs:
		og_prot_faa = soc_og_protseq_dir + og + '.faa'
		og_prot_msa = soc_og_protalgn_dir + og + '.msa.faa'
		og_prot_hmm = soc_og_hmm_dir + og + '.hmm'
		og_prot_con = soc_og_consensus_dir + og + '.faa'

		if os.path.isfile(og_prot_msa) and os.path.getsize(og_prot_msa) > 50:
			hmmbuild_cmd = ['hmmbuild', '--amino', '--cpu', '1', '-n', og, og_prot_hmm, og_prot_msa]
			hmmbuild_cmds.append(hmmbuild_cmd)
	
			hmmemit_cmd = ['hmmemit', '-c', '-o', og_prot_con, og_prot_hmm, ]
			hmmemit_cmds.append(hmmemit_cmd)
		else:
			annotation_notes[og] = 'alignment timed out during construction to generate consensus sequence for annotation - full set of protein sequences for the orthogroup can be found at: %s' % og_prot_faa

	if len(hmmbuild_cmds) > 0:
		try:
			with concurrent.futures.ThreadPoolExecutor(max_workers=threads) as executor:
				list(executor.map(util.multiProcessNoLog, hmmbuild_cmds))
		except Exception as e:
			msg = 'Issues running hmmbuild in parallel.\n'
			sys.stderr.write(msg)
			sys.stderr.write(traceback.format_exc())
			sys.exit(1)

		try:
			with concurrent.futures.ThreadPoolExecutor(max_workers=threads) as executor:
				list(executor.map(util.multiProcessNoLog, hmmemit_cmds))
		except Exception as e:
			msg = 'Issues running hmmemit in parallel.\n'
			sys.stderr.write(msg)
			sys.stderr.write(traceback.format_exc())
			sys.exit(1)

	consensus_results_file = outdir + 'Sociated_OGs_Consensus_Sequences.faa'
	with open(consensus_results_file, 'w') as crf_handle:
		con_seqs = 0
		for f in os.listdir(soc_og_consensus_dir):
			og = f.split('.faa')[0]
			con_seqs += 1
			with open(soc_og_consensus_dir + f) as ocf:
				for rec in SeqIO.parse(ocf, 'fasta'):
					crf_handle.write('>' + og + '\n' + str(rec.seq) + '\n')

	annot_dir = outdir + 'Sociated_OGs_Annotations/'
	annotation_result = annot_dir + 'Annotation_Results.tsv'
	# annotation columns reported (parsed by name from zol's annotateProtSeqs.py output, so columns missing in a
	# given zol version / database setup are simply reported as NA)
	annotation_columns = ['KO Annotation (E-value)', 'PGAP Annotation (E-value)', 'PaperBLAST Annotation (E-value)',
						  'CARD Annotation (E-value)', 'IS Finder (E-value)', 'MIBiG Annotation (E-value)',
						  'VOG Annotation (E-value)', 'VFDB Annotation (E-value)', 'DefenseFinder Annotation (E-value)',
						  'Pfam Domains']
	soc_og_annotations = defaultdict(lambda: ['NA']*len(annotation_columns))
	if con_seqs > 0:
		annotate_cmd = ['annotateProtSeqs.py', '-i', consensus_results_file, '-o', annot_dir, '-c', str(threads)]
		util.runCmdViaSubprocess(annotate_cmd, logObject=logObject, check_files=[annotation_result])
		with open(annotation_result) as oar:
			annot_header = None
			for line in oar:
				line = line.strip('\n')
				ls = line.split('\t')
				if annot_header is None:
					annot_header = {c: idx for idx, c in enumerate(ls)}
					continue
				soc_og_annotations[ls[0]] = [ls[annot_header[c]] if c in annot_header and annot_header[c] < len(ls) else 'NA' for c in annotation_columns]

	# Step 7: Create final results file and visualizations
	track_dir = outdir + 'Tracks_for_Visual/'
	plot_dir = viz_outdir + 'Plots/'
	util.setupReadyDirectory([track_dir, plot_dir])

	final_result_tsv = outdir + 'Final_Sociated_Results.tsv'
	with open(final_result_tsv, 'w') as frt:
		header = ['focal GCF', 'associated GCF/OG', 'allele frequency', 'direction', 'frequency in samples with focal GCF',
				  'frequency in samples without focal GCF', 'pvalue', 'phylogenetically corrected pvalue', 'beta', 
				  'beta-std-err', 'variant_h2', 'notes', 'annotation notes'] + annotation_columns
		frt.write('\t'.join(header) + '\n')
		foc_gcfs_with_hits = set([])
		for hit in hits:
			foc_gcf = hit[0]
			foc_gcfs_with_hits.add(foc_gcf)
			track_file = track_dir + foc_gcf + '.txt'
		
			if not (len(gcf_samples[foc_gcf]) > 0):
				msg = 'Issue finding samples with the GCF ' + foc_gcf + ' - this should not happen!'
				sys.stderr.write(msg + '\n')
				logObject.error(msg)
				continue

			w_prop, wo_prop, direction = computeDirection(foc_gcf, hit[1], gcf_samples, og_samples, all_samples)
	
			with open(track_file, 'a+') as tfh:
				if hit[1].startswith('GCF'):  
					for s in gcf_samples[hit[1]]:
						tfh.write('\t'.join([hit[1], s, hit[4], direction]) + '\n')
				else:
					for s in og_samples[hit[1]]:
						tfh.write('\t'.join([hit[1], s, hit[4], direction]) + '\n')

			frt.write('\t'.join(hit[:3] + [direction, str(w_prop), str(wo_prop)] +  hit[3:] + [annotation_notes[hit[1]]] + soc_og_annotations[hit[1]]) + '\n')


	plot_inputs = []
	for fg in foc_gcfs_with_hits:
		track_file = track_dir + fg + '.txt'
		plot_file = plot_dir + fg + '.pdf'
		with open(track_file, 'a+') as tfh:
			for s in gcf_samples[fg]:
				tfh.write('\t'.join(['focal_GCF', s, str(0.0), 'focal']) + '\n')
		plot_inputs.append([fg, species_tree, track_file, plot_file, logObject])

	os.environ["OMP_NUM_THREADS"] = "1"
	try:
		with concurrent.futures.ThreadPoolExecutor(max_workers=threads) as executor:
			plot_results = list(executor.map(runPlotting, plot_inputs))
			failed_plots = len([x for x in plot_results if x is False])
			if failed_plots > 0:
				msg = 'Warning: %d of %d plots could not be created - see the log file for details.' % (failed_plots, len(plot_inputs))
				sys.stderr.write(msg + '\n')
				logObject.warning(msg)
	except Exception as e:
		msg = 'Issues running plotting in parallel.\n'
		sys.stderr.write(msg)
		sys.stderr.write(traceback.format_exc())
		sys.exit(1)
	os.environ["OMP_NUM_THREADS"] = "4"

	# Write checkpoint file 
	checkpoint_file = outdir + 'CHECKPOINT.txt'
	with open(checkpoint_file, 'w') as checkpoint_handle:
		checkpoint_handle.write('lsaBGC-Sociate completed successfully!')

	# Close logging object and exit
	util.closeLoggerObject(logObject)
	sys.exit(0)

def computeDirection(foc_gcf, feature, gcf_samples, og_samples, all_samples):
	"""
	Compute the frequency of a feature (OG or GCF) in samples with and without the focal GCF and the direction of
	the association.
	"""
	foc_gcf_samples = gcf_samples[foc_gcf]
	feature_samples = gcf_samples[feature] if feature.startswith('GCF') else og_samples[feature]
	w_focgcf_w_socfeat = len([s for s in feature_samples if s in foc_gcf_samples])
	wo_focgcf_w_socfeat = len(feature_samples) - w_focgcf_w_socfeat

	w_prop = w_focgcf_w_socfeat / len(foc_gcf_samples)
	wo_prop = 0.0
	if (len(all_samples) - len(foc_gcf_samples)) > 0:
		wo_prop = wo_focgcf_w_socfeat / (len(all_samples) - len(foc_gcf_samples))

	direction = 'positive'
	if w_prop == wo_prop:
		direction = '-'
	elif w_prop < wo_prop:
		direction = 'negative'
	return w_prop, wo_prop, direction

def runPlotting(inputs):
	gcf_id, species_tree, track_file, pdf_file, logObject = inputs
	title = 'lsaBGC-Sociate: features (dis-)associated with %s' % gcf_id
	html_file = os.path.splitext(pdf_file)[0] + '.html'
	phyloplot.safely_create(phyloplot.sociate_html, species_tree, track_file, html_file, title, logObject=logObject)
	try:
		phyloplot.sociate_pdf(species_tree, track_file, pdf_file, title)
		return True
	except Exception as e:
		msg = 'Issues running creation of lsaBGC-Sociate phylo-heatmap plot for associated features: %s' % gcf_id
		sys.stderr.write(msg + '\n')
		logObject.error(msg)
		sys.stderr.write(traceback.format_exc() + '\n')
		logObject.error(traceback.format_exc())
		return False

if __name__ == '__main__':
	lsaBGC_Sociate()
